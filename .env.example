# Backend
SERVER_PORT=8080
# X-Session-Id no longer controls ownership.

# Account / mail: development example only. Production must use prod + smtp + HTTPS.
SPRING_PROFILES_ACTIVE=dev
APP_MAIL_MODE=capture
APP_PUBLIC_ORIGIN=http://127.0.0.1:5175
APP_AUTH_SECURE_COOKIE=false
# Temporary anonymous quota: 3 successful reviews, including iterations.
APP_ANONYMOUS_QUOTA=3
# Global daily attempt budget, configurable; not a production capacity commitment.
APP_DAILY_REVIEW_LIMIT=200
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# MySQL
MYSQL_URL=jdbc:mysql://localhost:3306/czspig_product_critic?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
MYSQL_USERNAME=root
MYSQL_PASSWORD=

# AI Provider: auto | deepseek | mock
APP_AI_PROVIDER=auto
APP_AI_FALLBACK_TO_MOCK=false

# DeepSeek. Do not commit real keys.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_TOKENS=3000
DEEPSEEK_TEMPERATURE=0.6
